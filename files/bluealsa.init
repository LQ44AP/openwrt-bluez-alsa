#!/bin/sh /etc/rc.common

START=94
USE_PROCD=1

start_service() {
    config_load bluealsa
    local enabled sink source name monitor_enabled aac hci sysbus mac

    config_get_bool enabled         main     enabled          1
    config_get_bool sink            main     sink_enabled     1
    config_get_bool source          main     source_enabled   1
    config_get_bool aac             main     aac_afterburner  1
    config_get      name            main     device_name      'OpenWrt-BT'
    config_get      hci             main     hci              'hci0'
    config_get_bool sysbus          main     sysbus           1
    config_get_bool monitor_enabled settings enabled           0
    config_get      mac             settings mac

    [ "$enabled" -eq 0 ] && return 0

    if [ "$sink" -eq 0 ] && [ "$source" -eq 0 ]; then
        logger -t bluealsa "sink/source 均未启用，跳过启动"
        return 0
    fi

    # ---------- 1. bluealsad 主进程 ----------
    local args="-i $hci"
    [ "$sysbus" -eq 1 ] && args="-S $args"
    [ "$sink"   -eq 1 ] && args="$args -p a2dp-sink"
    [ "$source" -eq 1 ] && args="$args -p a2dp-source"
    [ "$aac"    -eq 1 ] && args="$args --codec=aac"

    procd_open_instance "main"
    procd_set_param command /usr/bin/bluealsad $args
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/bluealsa
    procd_close_instance

    # ---------- 2. 接收模式：bluealsa-aplay ----------
    if [ "$sink" -eq 1 ]; then
        procd_open_instance "aplay"
        procd_set_param command /usr/bin/bluealsa-aplay --profile=a2dp --pcm=default
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi

    # ---------- 3. 发射模式：自动重连监控 ----------
    if [ "$source" -eq 1 ] && [ "$monitor_enabled" -eq 1 ] && [ -n "$mac" ]; then
        procd_open_instance "monitor"
        procd_set_param command /bin/sh /usr/bin/bt_monitor.sh
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_set_param file /etc/config/bluealsa
        procd_close_instance
    fi

    # ---------- 4. 适配器别名 / 可发现 ----------
    setup_hci "$hci" "$name" "$sink"
}

setup_hci() {
    local hci="$1" name="$2" sink="$3"

    if command -v bluetoothctl >/dev/null 2>&1; then
        local i=0
        while [ "$i" -lt 10 ]; do
            bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && break
            sleep 1
            i=$((i + 1))
        done

        bluetoothctl system-alias "$name" >/dev/null 2>&1

        if [ "$sink" -eq 1 ]; then
            bluetoothctl pairable on     >/dev/null 2>&1
            bluetoothctl discoverable on >/dev/null 2>&1
        else
            bluetoothctl discoverable off >/dev/null 2>&1
        fi
    elif command -v hciconfig >/dev/null 2>&1; then
        hciconfig "$hci" up
        hciconfig "$hci" name "$name"
        if [ "$sink" -eq 1 ]; then
            hciconfig "$hci" piscan
        else
            hciconfig "$hci" noscan
        fi
    else
        logger -t bluealsa "警告: 既无 bluetoothctl 也无 hciconfig，跳过适配器配置"
    fi
}

stop_service() {
    if command -v bluetoothctl >/dev/null 2>&1; then
        bluetoothctl discoverable off >/dev/null 2>&1
        bluetoothctl pairable     off >/dev/null 2>&1
    fi
}

service_triggers() {
    procd_add_reload_trigger "bluealsa"
}
