config bluealsa 'main'
    option enabled '0'
    # 接收模式：手机 -> 路由器（bluealsa-aplay 播到本地声卡）
    option sink_enabled '0'
    # 发射模式：路由器 -> 蓝牙耳机（bluealsa 转发给对端）
    option source_enabled '1'
    option device_name 'OpenWrt-BT'
    option aac_afterburner '1'

config bluetooth 'settings'
    # 发射模式下的自动重连监控开关
    option enabled '1'
    # 你的蓝牙耳机 MAC（小写，冒号分隔）
    option mac ''

config monitor 'monitor'
    option scan_duration '8'
    option ping_timeout '2'
    option connect_wait_max '20'
    option disconnected_sleep '30'
    option connected_sleep '20'
    option clean_other_devices '1'
